<?xml version="1.0" encoding="utf-8" ?>
<phpunit bootstrap="./tests/bootstrap.php"
         colors="true"
         verbose="true"
         stopOnFailure="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
            <exclude>tests/BaseObjectTest.php</exclude>
            <exclude>tests/PhpGridTest.php</exclude>
        </testsuite>
        <testsuite name="Integration">
            <file>tests/BaseObjectTest.php</file>
            <file>tests/PhpGridTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>